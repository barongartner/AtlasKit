# Atlas settings. Blank means "use the default" or "feature off".
# Owner details (name, phone, time zone, city) live in Shared\.env, not here.

# iMessage bridge
# Matrix access token for the bridge; turns iMessage on
MATRIX_TOKEN=
# default http://127.0.0.1:8008
MATRIX_URL=
# room for texts Atlas starts itself
IMESSAGE_HOME_ROOM=
# default tel:<OWNER_PHONE>
IMESSAGE_OWNER=
# default mailto:<BOT_APPLE_ID with +atlas>
IMESSAGE_VIA=
# default mailto:<BOT_APPLE_ID>
IMESSAGE_ALSO=
# default 1 (Atlas answers untagged messages)
IMESSAGE_DEFAULT=

# Telegram (optional, replies only)
# from @BotFather
TELEGRAM_BOT_TOKEN=
# filled in by the first private chat that messages the bot
ALLOWED_CHAT_IDS=

# Claude
# model for real conversations; blank = CLI default
CLAUDE_MODEL=
# e.g. medium for snappier replies
CLAUDE_EFFORT=
# per-turn limit in minutes, default 30
CLAUDE_TIMEOUT_MIN=
# model for heartbeats and bus turns, default sonnet
HEARTBEAT_MODEL=
# cap on downloads + transcription per batch, default 300
INTAKE_TIMEOUT_SEC=

# Schedule
# default 60, 0 turns heartbeats off
HEARTBEAT_MINUTES=
# default 23:00-08:00
QUIET_HOURS=
# minutes between Gmail watch safety sweeps, default 30; 0 turns every watch off
WATCH_MINUTES=

# Apple (calendar, reminders, notes)
# default OWNER_EMAIL
APPLE_ID=
# app-specific password from account.apple.com
APPLE_APP_PASSWORD=
# calendar new events go to; blank = first event calendar
CALENDAR_NAME=
# default list for new reminders; blank = Reminders or To Do
REMINDERS_LIST=
# exact iPhone name for Find My; blank = guess
FIND_MY_DEVICE=

# Extra calendar feeds
# comma-separated ICS subscription URLs
ICS_FEEDS=

# Gmail
# default OWNER_EMAIL
GMAIL_ADDRESS=
# app password from myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
