# Atlas Kit settings for this install. Setup copies this to Shared\.env and
# fills it in. Never commit the real .env.

# Who owns this install. The bots only take orders from OWNER_PHONE.
OWNER_NAME=
OWNER_PHONE=
OWNER_EMAIL=
OWNER_CITY=
# IANA time zone, e.g. America/Toronto, America/Vancouver, America/Chicago
OWNER_TIMEZONE=

# The separate Apple ID the iMessage bridge signs in with. Never the owner's
# main Apple ID. Atlas texts from +atlas and Iris from +iris on this address.
BOT_APPLE_ID=

# WSL distro the bridge runs in, and the local Matrix server's name.
WSL_DISTRO=Ubuntu-24.04
MATRIX_SERVER_NAME=atlas.local

# The bots' Claude login. Run `claude setup-token` in a terminal and paste the
# token here. Good for about a year. Use the owner's own Claude plan.
CLAUDE_CODE_OAUTH_TOKEN=
