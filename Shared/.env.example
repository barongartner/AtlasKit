# Atlas Kit settings for this install. Setup copies this to Shared\.env and
# fills it in. Never commit the real .env.

# Who owns this install. The bots only take orders from OWNER_PHONE.
OWNER_NAME=
OWNER_PHONE=
OWNER_EMAIL=
OWNER_CITY=
# IANA time zone, e.g. America/Toronto, America/Vancouver, America/Chicago
OWNER_TIMEZONE=

# The separate Apple ID the iMessage bridge signs in with. Never the owner's
# main Apple ID. Atlas texts from +atlas and Iris from +iris on this address.
BOT_APPLE_ID=

# WSL distro the bridge runs in, and the local Matrix server's name.
WSL_DISTRO=Ubuntu-24.04
MATRIX_SERVER_NAME=atlas.local

# The bots' Claude login. Run `claude setup-token` in a terminal and paste the
# token here. Good for about a year. Use the owner's own Claude plan.
CLAUDE_CODE_OAUTH_TOKEN=

# ---- Add-ons (Shared\addons.py; the app's Add-ons page fills these in) ----
# Each add-on's switch is ADDON_<ID>=on or off. Blank means: on for weather
# alerts and voice notes, on once its settings are filled in for the rest.
# IDs: WEATHER_ALERTS VOICE_NOTES CALENDAR REMINDERS GMAIL FEEDS IRIS_EMAIL
# PIXABAY SPOTIFY APPLE_MUSIC NOTION STRAVA COMMUTE
ADDON_WEATHER_ALERTS=
ADDON_VOICE_NOTES=

# Weather alerts (uses OWNER_CITY). Units c or f, blank picks from the country.
# Limits are in those units; blank is -25 C / -13 F feels-like, 33 C / 91 F.
WEATHER_UNITS=
WEATHER_COLD_BELOW=
WEATHER_HEAT_ABOVE=

# Voice notes: base.en (default), small.en, base or small. Cached in Models\.
VOICE_NOTES_MODEL=

# Spotify: the Client ID of the owner's own app at developer.spotify.com, with
# redirect URI http://127.0.0.1:47823/callback. Connect fills in the tokens.
SPOTIFY_CLIENT_ID=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_TOKEN_EXPIRES=

# Apple Music: search works with nothing set. Sign in from the app for the
# library; it saves the web player's tokens here (they expire every few months).
# Country is two letters, like us or ca; blank uses the account's store.
APPLE_MUSIC_COUNTRY=
APPLE_MUSIC_DEV_TOKEN=
APPLE_MUSIC_USER_TOKEN=
APPLE_MUSIC_STOREFRONT=

# Notion: the Internal Integration Secret (starts with ntn_) from
# notion.so/profile/integrations. Share pages with it in Notion.
NOTION_TOKEN=

# Strava: the owner's own app at strava.com/settings/api, callback domain
# 127.0.0.1. Connect fills in the tokens and STRAVA_UNITS (km or mi).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
STRAVA_ACCESS_TOKEN=
STRAVA_TOKEN_EXPIRES=
STRAVA_UNITS=

# Commute: a free TomTom key (developer.tomtom.com), and saved places.
# COMMUTE_PLACES is name=address pairs separated by semicolons.
TOMTOM_KEY=
COMMUTE_HOME=
COMMUTE_WORK=
COMMUTE_SCHOOL=
COMMUTE_PLACES=

# The local port Spotify and Strava sign-ins come back to. Change it only if
# something else uses it, and then fix the Spotify redirect URI to match.
ADDONS_OAUTH_PORT=
