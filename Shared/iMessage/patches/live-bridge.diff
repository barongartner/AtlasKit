+// ---------------------------------------------------------------------------
+// Crew patch 2026-10-20: answering FaceTime calls (Atlas).
+//
+// The handles in FACETIME_ANSWER_HANDLES (comma list, set in start.sh) get
+// their rings answered by a web client instead of just a notice:
+//
+//   1. A ring on one of those handles binds that handle's own bridge-owned
+//      link ("answer:<handle>", minted once, lives a year) to the ringing
+//      session, and the ring notice carries the link (`via=... link=...`).
+//   2. The bot opens the link in Chrome. The web page sends a LetMeIn to the
+//      link's pseudonym, which is this bridge.
+//   3. A LetMeIn for a bound link is approved into that session:
+//      respond_letmein props the call (rustpush's join(), signaling only
+//      because this bridge never sets local interfaces) and adds the web
+//      client, which then joins and carries the audio. rustpush unprops when
+//      the web client's join arrives.
+//
+// A bind is used once and expires after ANSWER_WINDOW, and only links this
+// bridge minted for a ring can be bound, so a LetMeIn anywhere else is left
+// alone. The link itself only ever goes to the local Matrix room.
+
+const ANSWER_USAGE_PREFIX: &str = "answer:";
+const ANSWER_WINDOW: std::time::Duration = std::time::Duration::from_secs(90);
+
+/// (answer link pseudonym, ringing session guid, when it was bound)
+static ANSWER_BINDS: std::sync::Mutex<Vec<(String, String, std::time::Instant)>> =
+    std::sync::Mutex::new(Vec::new());
+
+fn answer_handles() -> Vec<String> {
+    std::env::var("FACETIME_ANSWER_HANDLES")
+        .unwrap_or_default()
+        .split(',')
+        .map(|h| h.trim().to_lowercase())
+        .filter(|h| !h.is_empty())
+        .collect()
+}
+
+/// The session guid of an event that means someone is calling us.
+fn ring_guid(event: &rustpush::facetime::FTMessage) -> Option<&str> {
+    use rustpush::facetime::FTMessage;
+    match event {
+        FTMessage::Ring { guid } => Some(guid),
+        FTMessage::JoinEvent { guid, ring: true, .. } => Some(guid),
+        FTMessage::AddMembers { guid, ring: true, .. } => Some(guid),
+        _ => None,
+    }
+}
+
+/// Get (or mint) the answer link for a handle. Bounded and panic-guarded:
+/// minting talks to Apple and validate_pseudonym panics on a missing cache.
+async fn answer_link(facetime: &rustpush::facetime::FTClient, handle: &str) -> Option<String> {
+    let usage = format!("{ANSWER_USAGE_PREFIX}{handle}");
+    let minted = tokio::time::timeout(
+        std::time::Duration::from_secs(15),
+        crate::panic_guard::guard_panic("FaceTime answer link", facetime.get_link_for_usage(handle, &usage)),
+    )
+    .await;
+    match minted {
+        Ok(Some(Ok(link))) => Some(link),
+        Ok(Some(Err(e))) => {
+            warn!("FaceTime answer: couldn't get a link for {handle}: {e:?}");
+            None
+        }
+        Ok(None) => None, // panicked, the guard logged it
+        Err(_) => {
+            warn!("FaceTime answer: getting a link for {handle} timed out");
+            None
+        }
+    }
+}
+
+/// For a ring on an answer handle: bind that handle's link to the ringing
+/// session and return (called handle, link) for the ring notice.
+pub(crate) async fn answer_link_for_ring(
+    facetime: &rustpush::facetime::FTClient,
+    event: &rustpush::facetime::FTMessage,
+) -> Option<(String, String)> {
+    let guid = ring_guid(event)?.to_string();
+    let wanted = answer_handles();
+    if wanted.is_empty() {
+        return None;
+    }
+    let handle = {
+        let state = facetime.state.read().await;
+        let session = state.sessions.get(&guid)?;
+        session.my_handles.iter().find(|h| wanted.contains(&h.to_lowercase()))?.clone()
+    };
+    let link = answer_link(facetime, &handle).await?;
+    let usage = format!("{ANSWER_USAGE_PREFIX}{handle}");
+    let pseud = {
+        let state = facetime.state.read().await;
+        state.links.values().find(|l| l.usage.as_deref() == Some(usage.as_str()))?.pseud.clone()
+    };
+    let mut binds = ANSWER_BINDS.lock().unwrap();
+    binds.retain(|(p, _, at)| p != &pseud && at.elapsed() < ANSWER_WINDOW);
+    binds.push((pseud, guid.clone(), std::time::Instant::now()));
+    info!("FaceTime answer: {handle} is ringing (call {guid}), its link is bound to the call");
+    Some((handle, link))
+}
+
+/// The ringing call a LetMeIn's link was bound to, if the bind is still
+/// fresh. Uses the bind up.
+fn take_answer_bind(pseud: &str) -> Option<String> {
+    let mut binds = ANSWER_BINDS.lock().unwrap();
+    binds.retain(|(_, _, at)| at.elapsed() < ANSWER_WINDOW);
+    let i = binds.iter().position(|(p, _, _)| p == pseud)?;
+    Some(binds.remove(i).1)
+}
+
+/// A LetMeIn on a bound answer link: approve it into the ringing call.
+/// Spawned, because respond_letmein props the call and waits on Apple, and
+/// the receive loop must never wait on that.
+pub(crate) fn maybe_answer_letmein(
+    facetime: std::sync::Arc<rustpush::facetime::FTClient>,
+    event: &rustpush::facetime::FTMessage,
+) {
+    let rustpush::facetime::FTMessage::LetMeInRequest(request) = event else { return };
+    let Some(guid) = take_answer_bind(&request.pseud) else {
+        info!("FaceTime LetMeIn on {} isn't for a ringing answer link, left alone", request.pseud);
+        return;
+    };
+    let request = request.clone();
+    tokio::spawn(async move {
+        info!(
+            "FaceTime answer: letting {} ({:?}) into call {guid}",
+            request.requestor, request.nickname
+        );
+        // The prop needs this device's participant id in the call. Apple
+        // usually pushes one with the ring (a quickrelay allocation); when it
+        // doesn't, rustpush asks for one, and with this account's empty
+        // FaceTime key lookups that request hung 15 s twice and the call rang
+        // out (2026-10-20, 11:31 PM). Skip the prop then: is_ringing_inaccurate
+        // is what makes respond_letmein prop.
+        let my_token = crate::base64_encode(&facetime.conn.get_token().await);
+        {
+            let mut state = facetime.state.write().await;
+            if let Some(session) = state.sessions.get_mut(&guid) {
+                let have_id = session
+                    .participants
+                    .values()
+                    .any(|p| p.token.as_deref() == Some(my_token.as_str()));
+                if !have_id && session.is_ringing_inaccurate {
+                    warn!("FaceTime answer: Apple gave no participant id for call {guid}, letting the web client in without the prop");
+                    session.is_ringing_inaccurate = false;
+                }
+                // A call this bridge started is already propped by create_session.
+                if session.is_propped {
+                    session.is_ringing_inaccurate = false;
+                }
+            }
+        }
+        for attempt in 0..3u32 {
+            let mut req = request.clone();
+            if attempt > 0 {
+                // the first try already used up the delegation entry
+                req.delegation_uuid = None;
+            }
+            let outcome = crate::panic_guard::guard_panic(
+                "FaceTime respond_letmein",
+                facetime.respond_letmein(req, Some(&guid)),
+            )
+            .await;
+            match outcome {
+                Some(Ok(())) => {
+                    info!("FaceTime answer: approved, the web client is joining call {guid}");
+                    return;
+                }
+                Some(Err(rustpush::PushError::SendTimedOut)) if attempt < 2 => {
+                    warn!("FaceTime answer: approve timed out (try {}), retrying", attempt + 1);
+                    tokio::time::sleep(std::time::Duration::from_secs((attempt + 1) as u64)).await;
+                }
+                Some(Err(e)) => {
+                    warn!("FaceTime answer: approving into call {guid} failed: {e:?}");
+                    return;
+                }
+                None => return, // panicked, the guard logged it
+            }
+        }
+    });
+}
+
+/// Have each answer handle's link ready before its first ring (minting it
+/// takes a round trip to Apple, which a ring can't spare).
+pub(crate) fn premint_answer_links(facetime: std::sync::Arc<rustpush::facetime::FTClient>) {
+    let handles = answer_handles();
+    if handles.is_empty() {
+        return;
+    }
+    tokio::spawn(async move {
+        tokio::time::sleep(std::time::Duration::from_secs(45)).await;
+        for handle in handles {
+            if answer_link(facetime.as_ref(), &handle).await.is_some() {
+                info!("FaceTime answer: link ready for {handle}");
+            }
+        }
+    });
+}
+
+// ---------------------------------------------------------------------------
+// Crew patch 2026-10-31: real calls, natively from this bridge, driven from a
+// control port.
+//
+// One command per connection, one line in, one JSON line out, on 127.0.0.1:8010
+// (WSL forwards it to Windows, Shared/call.py and the bots talk to it). Plain
+// lines on purpose: a web page can only send "POST / HTTP/1.1" at it, which is
+// not a command.
+//
+//   keys <via> <handle>   how many of their devices FaceTime can reach
+//   call <via> <handle>   ring them from <via>, the bot's own address
+//   answer <guid>         pick up a call that's ringing
+//   room <via>            a call with nobody else in it (to test the relay)
+//   state <guid>          who's in the call, how the audio is doing
+//   flush <guid>          drop whatever's queued to be said
+//   hangup <guid>         leave the call
+//
+// The audio itself is in facetime_native.rs. With local interfaces set,
+// rustpush's join() opens a real media session instead of the old prop for a
+// web client, so the LetMeIn code above stays idle (no FACETIME_ANSWER_HANDLES
+// in start.sh, no links are minted).
+
+const CONTROL_PORT: u16 = 8010;
+
+static CONTROL_CLIENT: std::sync::Mutex<Option<std::sync::Arc<rustpush::facetime::FTClient>>> =
+    std::sync::Mutex::new(None);
+static CONTROL_STARTED: std::sync::Once = std::sync::Once::new();
+
+pub(crate) fn control_client() -> Option<std::sync::Arc<rustpush::facetime::FTClient>> {
+    CONTROL_CLIENT.lock().unwrap().clone()
+}
+
+/// The address outgoing traffic leaves from. Nothing is actually sent: a UDP
+/// connect only picks the route.
+fn local_address() -> Option<std::net::IpAddr> {
+    let socket = std::net::UdpSocket::bind(("0.0.0.0", 0)).ok()?;
+    socket.connect(("1.1.1.1", 53)).ok()?;
+    Some(socket.local_addr().ok()?.ip())
+}
+
+/// Point the ports at the current FaceTime client. A reconnect builds a new
+/// client, so the listeners stay up and only this pointer moves.
+pub(crate) fn start_control_port(facetime: std::sync::Arc<rustpush::facetime::FTClient>) {
+    *CONTROL_CLIENT.lock().unwrap() = Some(facetime.clone());
+    tokio::spawn(async move {
+        match local_address() {
+            Some(address) => {
+                info!("FaceTime: native media on {address}");
+                facetime.set_local_interfaces(&[address]).await;
+            }
+            None => warn!("FaceTime: no local address, calls won't connect"),
+        }
+    });
+    crate::facetime_native::start_media_port(control_client);
+    CONTROL_STARTED.call_once(|| {
+        tokio::spawn(async move {
+            let listener = match tokio::net::TcpListener::bind(("127.0.0.1", CONTROL_PORT)).await {
+                Ok(listener) => listener,
+                Err(e) => {
+                    warn!("FaceTime control port {CONTROL_PORT} didn't open: {e}");
+                    return;
+                }
+            };
+            info!("FaceTime control port open on {CONTROL_PORT}");
+            loop {
+                let Ok((stream, _)) = listener.accept().await else { continue };
+                tokio::spawn(control_connection(stream));
+            }
+        });
+    });
+}
+
+async fn control_connection(stream: tokio::net::TcpStream) {
+    use tokio::io::{AsyncBufReadExt, AsyncReadExt, AsyncWriteExt};
+    let (read, mut write) = stream.into_split();
+    let mut reader = tokio::io::BufReader::new(read.take(2048));
+    let mut line = String::new();
+    let got = tokio::time::timeout(std::time::Duration::from_secs(5), reader.read_line(&mut line)).await;
+    if !matches!(got, Ok(Ok(n)) if n > 0) {
+        return;
+    }
+    let reply = match control_client() {
+        Some(client) => {
+            let line = line.trim().to_string();
+            info!("FaceTime control: {line}");
+            let run = crate::panic_guard::guard_panic("FaceTime control", control_command(client, line));
+            match tokio::time::timeout(std::time::Duration::from_secs(45), run).await {
+                Ok(Some(reply)) => reply,
+                Ok(None) => control_error("panicked"),
+                Err(_) => control_error("timed out"),
+            }
+        }
+        None => control_error("no FaceTime client yet"),
+    };
+    let _ = write.write_all(format!("{reply}\n").as_bytes()).await;
+}
+
+fn control_error(message: &str) -> String {
+    serde_json::json!({ "ok": false, "error": message }).to_string()
+}
+
+async fn control_command(facetime: std::sync::Arc<rustpush::facetime::FTClient>, line: String) -> String {
+    let words: Vec<&str> = line.split_whitespace().collect();
+    match words.as_slice() {
+        ["keys", via, handle] => match facetime.key_count(via, handle, true).await {
+            Ok(devices) => serde_json::json!({ "ok": true, "devices": devices }).to_string(),
+            Err(e) => control_error(&format!("{e:?}")),
+        },
+        ["call", via, handle] => {
+            // Nothing to ring means Apple gave no keys for them: not on
+            // FaceTime, or this account can't see them. Say so instead of
+            // sending an invitation to nobody.
+            match facetime.key_count(via, handle, true).await {
+                Ok(0) => return control_error("no_keys"),
+                Ok(_) => {}
+                Err(e) => return control_error(&format!("{e:?}")),
+            }
+            start_call(&facetime, via, &[handle.to_string()]).await
+        }
+        ["room", via] => start_call(&facetime, via, &[]).await,
+        ["answer", guid] => {
+            {
+                let mut state = facetime.state.write().await;
+                let Some(session) = state.sessions.get_mut(*guid) else {
+                    return control_error("no such call");
+                };
+                if let Err(e) = facetime.join(session, false).await {
+                    warn!("FaceTime call: couldn't answer {guid}: {e:?}");
+                    return control_error(&format!("{e:?}"));
+                }
+                session.is_ringing_inaccurate = false;
+            }
+            wire_audio(&facetime, guid).await
+        }
+        ["codectest"] => crate::facetime_native::codec_roundtrip().to_string(),
+        ["state", guid] => call_state(&facetime, guid).await,
+        ["flush", guid] => serde_json::json!({ "ok": crate::facetime_native::flush_audio(guid) }).to_string(),
+        ["hangup", guid] => {
+            hang_up(&facetime, guid).await;
+            serde_json::json!({ "ok": true }).to_string()
+        }
+        _ => control_error("unknown command"),
+    }
+}
+
+async fn start_call(facetime: &rustpush::facetime::FTClient, via: &str, targets: &[String]) -> String {
+    let guid = uuid::Uuid::new_v4().to_string().to_uppercase();
+    if let Err(e) = facetime.create_session(guid.clone(), via.to_string(), targets, false).await {
+        warn!("FaceTime call: couldn't start {guid}: {e:?}");
+        return control_error(&format!("{e:?}"));
+    }
+    info!("FaceTime call: {via} started {guid} for {targets:?}");
+    wire_audio(facetime, &guid).await
+}
+
+async fn wire_audio(facetime: &rustpush::facetime::FTClient, guid: &str) -> String {
+    let connection = facetime.state.read().await.sessions.get(guid).and_then(|s| s.connection.clone());
+    let Some(connection) = connection else {
+        return control_error("no media session");
+    };
+    crate::facetime_native::start_audio(connection, guid.to_string()).await;
+    serde_json::json!({ "ok": true, "guid": guid }).to_string()
+}
+
+async fn call_state(facetime: &rustpush::facetime::FTClient, guid: &str) -> String {
+    let state = facetime.state.read().await;
+    let Some(session) = state.sessions.get(guid) else {
+        return control_error("no such call");
+    };
+    let in_call: Vec<&str> = session
+        .participants
+        .values()
+        .filter(|p| p.active.is_some())
+        .map(|p| p.handle.as_str())
+        .collect();
+    let members: Vec<&str> = session.members.iter().map(|m| m.handle.as_str()).collect();
+    serde_json::json!({
+        "ok": true,
+        "in_call": in_call,
+        "members": members,
+        "mine": session.my_handles,
+        "connected": session.connection.is_some(),
+        "ringing": session.is_ringing_inaccurate,
+        "audio": crate::facetime_native::audio_stats(guid),
+    })
+    .to_string()
+}
+
+/// Leave the call and stop its audio. Safe to call twice.
+pub(crate) async fn hang_up(facetime: &rustpush::facetime::FTClient, guid: &str) {
+    crate::facetime_native::stop_audio(guid);
+    let mut state = facetime.state.write().await;
+    let Some(session) = state.sessions.get_mut(guid) else { return };
+    session.is_ringing_inaccurate = false;
+    if session.connection.is_none() && !session.is_propped {
+        return;
+    }
+    if let Err(e) = facetime.leave(session).await {
+        warn!("FaceTime call: leaving {guid} failed: {e:?}");
+    }
+}
