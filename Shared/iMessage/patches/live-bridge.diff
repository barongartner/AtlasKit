+package connector
+
+// Bubble effects, screen effects and text formatting on outgoing messages
+// (Atlas, 2026-11-17). Before this the bridge sent every message as plain
+// text: it passed no HTML to rustpush and always sent effect None, so the
+// bots could never slam a text, send confetti or bold a word the way a
+// person on an iPhone can.
+//
+// A bot asks for an effect with the custom field "com.atlas.effect" on its
+// m.text event (a friendly name like "slam" or "confetti", or a raw Apple
+// effect id), and for formatting with an ordinary org.matrix.custom.html
+// formatted_body (<b> <i> <u> <s> and
+// <span data-mx-imessage-effect="big">, the same markup the bridge already
+// produces for the owner's incoming formatting).
+
+import (
+	"html"
+	"regexp"
+	"strings"
+
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/event"
+)
+
+const effectKey = "com.atlas.effect"
+
+// notifyAnywayKey on a bot's message (true) makes it break through the
+// recipient's Focus, like tapping "Notify Anyway" on an iPhone.
+const notifyAnywayKey = "com.atlas.notify_anyway"
+
+func wantsNotifyAnyway(msg *bridgev2.MatrixMessage) bool {
+	if msg == nil || msg.Event == nil {
+		return false
+	}
+	v, _ := msg.Event.Content.Raw[notifyAnywayKey].(bool)
+	return v
+}
+
+// iMessage's own effect ids, by the names on the iPhone's "Send with
+// effect" screen.
+var outboundEffects = map[string]string{
+	// Bubble
+	"slam":          "com.apple.MobileSMS.expressivesend.impact",
+	"loud":          "com.apple.MobileSMS.expressivesend.loud",
+	"gentle":        "com.apple.MobileSMS.expressivesend.gentle",
+	"invisible ink": "com.apple.MobileSMS.expressivesend.invisibleink",
+	// Screen
+	"echo":          "com.apple.messages.effect.CKEchoEffect",
+	"spotlight":     "com.apple.messages.effect.CKSpotlightEffect",
+	"balloons":      "com.apple.messages.effect.CKHappyBirthdayEffect",
+	"confetti":      "com.apple.messages.effect.CKConfettiEffect",
+	"love":          "com.apple.messages.effect.CKHeartEffect",
+	"lasers":        "com.apple.messages.effect.CKLasersEffect",
+	"fireworks":     "com.apple.messages.effect.CKFireworksEffect",
+	"celebration":   "com.apple.messages.effect.CKSparklesEffect",
+	"shooting star": "com.apple.messages.effect.CKShootingStarEffect",
+}
+
+// outboundEffect is the Apple effect id the bot asked for, or "".
+func outboundEffect(msg *bridgev2.MatrixMessage) string {
+	if msg == nil || msg.Event == nil {
+		return ""
+	}
+	raw, _ := msg.Event.Content.Raw[effectKey].(string)
+	name := strings.ToLower(strings.TrimSpace(raw))
+	name = strings.NewReplacer("_", " ", "-", " ").Replace(name)
+	if id, ok := outboundEffects[name]; ok {
+		return id
+	}
+	switch name {
+	case "invisibleink", "ink":
+		return outboundEffects["invisible ink"]
+	case "heart", "hearts":
+		return outboundEffects["love"]
+	case "sparkles":
+		return outboundEffects["celebration"]
+	case "shootingstar":
+		return outboundEffects["shooting star"]
+	}
+	// A raw id passes through as long as it is one of Apple's.
+	if strings.HasPrefix(raw, "com.apple.MobileSMS.expressivesend.") ||
+		strings.HasPrefix(raw, "com.apple.messages.effect.CK") {
+		return strings.TrimSpace(raw)
+	}
+	return ""
+}
+
+var htmlTagRegex = regexp.MustCompile(`<[^>]*>`)
+var htmlParagraphEnd = regexp.MustCompile(`(?i)</p\s*>\s*`)
+var htmlParagraphStart = regexp.MustCompile(`(?i)<p(\s[^>]*)?>`)
+
+// outboundHTML returns the message's HTML in the shape rustpush's
+// parse_html_to_parts reads: tags it knows, text with only &amp; &lt; &gt;
+// and &quot; escaped (it decodes nothing else, so &#39; or &nbsp; would show
+// up literally on the phone), and paragraphs turned into line breaks (it
+// drops <p> without one). nil when there's no formatting to send.
+func outboundHTML(content *event.MessageEventContent) *string {
+	if content == nil || content.Format != event.FormatHTML || content.FormattedBody == "" {
+		return nil
+	}
+	src := htmlParagraphEnd.ReplaceAllString(content.FormattedBody, "<br><br>")
+	src = htmlParagraphStart.ReplaceAllString(src, "")
+	src = strings.TrimSuffix(src, "<br><br>")
+
+	var out strings.Builder
+	last := 0
+	for _, loc := range htmlTagRegex.FindAllStringIndex(src, -1) {
+		out.WriteString(reescapeText(src[last:loc[0]]))
+		out.WriteString(src[loc[0]:loc[1]])
+		last = loc[1]
+	}
+	out.WriteString(reescapeText(src[last:]))
+	s := out.String()
+	return &s
+}
+
+func reescapeText(s string) string {
+	if s == "" {
+		return s
+	}
+	s = html.UnescapeString(s)
+	s = strings.ReplaceAll(s, " ", " ")
+	return strings.NewReplacer("&", "&amp;", "<", "&lt;", ">", "&gt;", `"`, "&quot;").Replace(s)
+}
diff --git a/pkg/connector/richlink_image.go b/pkg/connector/richlink_image.go
new file mode 100644
index 0000000..f537e45
--- /dev/null
+++ b/pkg/connector/richlink_image.go
@@ -0,0 +1,175 @@
+package connector
+
+// Preview pictures on outgoing links (Atlas, 2026-11-17).
+//
+// The bridge sent every outgoing link as a title-only card: LPLinkMetadata
+// went out with no image, so the iPhone drew a compass icon where the
+// picture should be. An iPhone sends the preview picture inside the URL
+// balloon itself: the image bytes go in the balloon's attachment list and
+// LPLinkMetadata.image points at them by index. This file fetches the
+// page's og:image / twitter:image, shrinks it to a sane JPEG and leaves it
+// in a temp file; the Rust side (send_message in rustpushgo) reads the file,
+// deletes it and builds the balloon.
+
+import (
+	"bytes"
+	"context"
+	"image"
+	"image/jpeg"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	_ "image/gif"
+	_ "image/png"
+
+	"github.com/rs/zerolog"
+	"golang.org/x/image/draw"
+	_ "golang.org/x/image/webp"
+)
+
+const (
+	// Longest side of the picture we send. iPhones show the card at about
+	// 300 points wide, so 1200 px is sharp at 3x and keeps the balloon small.
+	richLinkMaxSide = 1200
+	// Pictures smaller than this are favicons or tracking pixels, not a
+	// preview picture worth a card.
+	richLinkMinSide = 120
+	// The site icon shows small beside the title; favicons are often 32 px.
+	richLinkIconMinSide = 32
+	richLinkIconMaxSide = 256
+	// Target size of the encoded JPEG. The balloon goes up through MMCS, so
+	// this is about keeping sends quick, not a hard limit.
+	richLinkMaxBytes = 600 * 1024
+	// Temp files the Rust side never picked up (a send that failed before it
+	// got that far) are cleared after this long.
+	richLinkStaleAfter = time.Hour
+	richLinkFilePrefix = "richlink-"
+)
+
+// richLinkImage is a preview picture ready to send.
+type richLinkImage struct {
+	Path   string // temp JPEG; the Rust side deletes it once read
+	URL    string // where the picture came from (LPImageMetadata.URL)
+	Width  int
+	Height int
+}
+
+// prepareRichLinkImage downloads the preview picture `imageRef` (as found in
+// the page at `pageURL`, so it may be relative) and writes it as a JPEG temp
+// file. `isIcon` is for the site's icon, which is small and square, instead
+// of the page's big picture. It returns nil when there is no usable picture;
+// a link then goes out as the old title-only card, never not at all.
+func prepareRichLinkImage(ctx context.Context, pageURL, imageRef string, isIcon bool) *richLinkImage {
+	log := zerolog.Ctx(ctx)
+	clearStaleRichLinkFiles()
+
+	imageRef = strings.TrimSpace(imageRef)
+	if imageRef == "" {
+		return nil
+	}
+	base, err := url.Parse(pageURL)
+	if err != nil {
+		return nil
+	}
+	ref, err := url.Parse(imageRef)
+	if err != nil {
+		return nil
+	}
+	abs := base.ResolveReference(ref)
+	if abs.Scheme != "http" && abs.Scheme != "https" {
+		return nil
+	}
+	imageURL := abs.String()
+
+	fetchCtx, cancel := context.WithTimeout(ctx, 15*time.Second)
+	defer cancel()
+	data, _, err := downloadURL(fetchCtx, imageURL)
+	if err != nil {
+		log.Debug().Err(sanitizeURLError(err, imageURL)).Msg("Couldn't download the link preview picture")
+		return nil
+	}
+	src, format, err := image.Decode(bytes.NewReader(data))
+	if err != nil {
+		log.Debug().Err(err).Int("bytes", len(data)).Msg("Link preview picture isn't an image we can read")
+		return nil
+	}
+	b := src.Bounds()
+	minSide, maxSide := richLinkMinSide, richLinkMaxSide
+	if isIcon {
+		minSide, maxSide = richLinkIconMinSide, richLinkIconMaxSide
+	}
+	if b.Dx() < minSide || b.Dy() < minSide {
+		log.Debug().Int("width", b.Dx()).Int("height", b.Dy()).Msg("Link preview picture too small, sending the card without it")
+		return nil
+	}
+
+	w, h := b.Dx(), b.Dy()
+	if w > maxSide || h > maxSide {
+		if w >= h {
+			h = h * maxSide / w
+			w = maxSide
+		} else {
+			w = w * maxSide / h
+			h = maxSide
+		}
+	}
+	// Always redraw onto an opaque white canvas: it flattens PNG/WebP
+	// transparency (JPEG has none, and a transparent logo would turn black)
+	// and scales in the same step.
+	dst := image.NewRGBA(image.Rect(0, 0, w, h))
+	draw.Draw(dst, dst.Bounds(), image.White, image.Point{}, draw.Src)
+	draw.CatmullRom.Scale(dst, dst.Bounds(), src, b, draw.Over, nil)
+
+	var out []byte
+	for _, q := range []int{85, 75, 65, 55} {
+		var buf bytes.Buffer
+		if err := jpeg.Encode(&buf, dst, &jpeg.Options{Quality: q}); err != nil {
+			log.Debug().Err(err).Msg("Couldn't encode the link preview picture")
+			return nil
+		}
+		out = buf.Bytes()
+		if len(out) <= richLinkMaxBytes {
+			break
+		}
+	}
+
+	f, err := os.CreateTemp("", richLinkFilePrefix+"*.jpg")
+	if err != nil {
+		log.Warn().Err(err).Msg("Couldn't save the link preview picture")
+		return nil
+	}
+	if _, err := f.Write(out); err != nil {
+		f.Close()
+		os.Remove(f.Name())
+		return nil
+	}
+	f.Close()
+
+	log.Debug().Bool("icon", isIcon).Str("format", format).Int("width", w).Int("height", h).Int("bytes", len(out)).
+		Msg("Link preview picture ready")
+	return &richLinkImage{Path: f.Name(), URL: imageURL, Width: w, Height: h}
+}
+
+// richLinkField strips the two bytes the sideband envelope uses as
+// separators (\x00 ends the envelope, \x01 splits its fields). A page title
+// carrying either would shift every field after it.
+func richLinkField(s string) string {
+	return strings.Map(func(r rune) rune {
+		if r == 0 || r == 1 {
+			return -1
+		}
+		return r
+	}, s)
+}
+
+func clearStaleRichLinkFiles() {
+	matches, _ := filepath.Glob(filepath.Join(os.TempDir(), richLinkFilePrefix+"*.jpg"))
+	for _, m := range matches {
+		if fi, err := os.Stat(m); err == nil && time.Since(fi.ModTime()) > richLinkStaleAfter {
+			os.Remove(m)
+		}
+	}
+}
diff --git a/pkg/connector/stack.go b/pkg/connector/stack.go
new file mode 100644
index 0000000..2c63025
--- /dev/null
+++ b/pkg/connector/stack.go
@@ -0,0 +1,95 @@
+package connector
+
+// Photo stacks (Atlas, 2026-11-17). An iPhone sends several pictures picked
+// together as ONE message that shows as a stack; the bridge could only send
+// one file per message, so a bot's three pictures landed as three bubbles.
+//
+// A bot sends the first picture as a normal m.image and lists the rest in
+// "com.atlas.stack": [{"url": "mxc://...", "mimetype": "image/jpeg",
+// "filename": "x.jpg"}, ...]. handleMatrixFile sends them all with
+// SendAttachments.
+
+import (
+	"bytes"
+	"context"
+	"image/jpeg"
+	"path/filepath"
+	"strings"
+
+	"github.com/rs/zerolog"
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/id"
+
+	"github.com/lrhodin/imessage/pkg/rustpushgo"
+)
+
+const stackKey = "com.atlas.stack"
+
+// An iPhone caps a stack well above this; ten keeps a bot from flooding.
+const maxStackExtras = 9
+
+// stackExtras downloads the extra files a bot listed and readies them the
+// same way handleMatrixFile readies the first one. A file that fails to
+// download is left out rather than failing the whole stack.
+func (c *IMClient) stackExtras(ctx context.Context, msg *bridgev2.MatrixMessage) []rustpushgo.WrappedOutboundFile {
+	if msg == nil || msg.Event == nil {
+		return nil
+	}
+	list, _ := msg.Event.Content.Raw[stackKey].([]any)
+	if len(list) == 0 {
+		return nil
+	}
+	log := zerolog.Ctx(ctx)
+	var out []rustpushgo.WrappedOutboundFile
+	for _, item := range list {
+		if len(out) >= maxStackExtras {
+			break
+		}
+		m, _ := item.(map[string]any)
+		url, _ := m["url"].(string)
+		if !strings.HasPrefix(url, "mxc://") {
+			continue
+		}
+		mime, _ := m["mimetype"].(string)
+		name, _ := m["filename"].(string)
+		if name == "" {
+			name = "photo"
+		}
+		data, err := c.Main.Bridge.Bot.DownloadMedia(ctx, id.ContentURIString(url), nil)
+		if err != nil {
+			log.Warn().Err(err).Str("url", url).Msg("Couldn't download a stack photo; sending the rest")
+			continue
+		}
+		data, mime, name = readyStackFile(data, mime, name)
+		out = append(out, rustpushgo.WrappedOutboundFile{
+			Data: data, Mime: mime, UtiType: mimeToUTI(mime), Filename: name,
+		})
+	}
+	return out
+}
+
+// readyStackFile mirrors handleMatrixFile's image handling: trust the bytes
+// over the label, keep JPEG/PNG/GIF/HEIC as they are, and turn anything an
+// iPhone can't show (WebP, TIFF, BMP) into JPEG.
+func readyStackFile(data []byte, mime, name string) ([]byte, string, string) {
+	if !looksLikeImage(data) {
+		if mime == "" {
+			mime = "application/octet-stream"
+		}
+		return data, mime, name
+	}
+	if detected := detectImageMIME(data); detected != "" {
+		mime = detected
+	}
+	switch mime {
+	case "image/jpeg", "image/png", "image/gif", "image/heic", "image/heif":
+		return data, mime, name
+	}
+	if img, _, _ := decodeImageData(data); img != nil {
+		var buf bytes.Buffer
+		if jpeg.Encode(&buf, img, &jpeg.Options{Quality: 95}) == nil {
+			return buf.Bytes(), "image/jpeg", strings.TrimSuffix(name, filepath.Ext(name)) + ".jpg"
+		}
+	}
+	return data, mime, name
+}
diff --git a/pkg/connector/share_profile.go b/pkg/connector/share_profile.go
new file mode 100755
index 0000000..9c98b8f
--- /dev/null
+++ b/pkg/connector/share_profile.go
@@ -0,0 +1,143 @@
+package connector
+
+// Shared name and photo (iMessage "Share Name and Photo"), the crew
+// patch 2026-10-20. The whole Apple account shows up as one identity
+// ("Iris"); each bot's +alias is its own thread, and the owner names the aliases
+// as separate contacts on his own phone.
+//
+//   share-profile <tel:+1...|mailto:...> [display name]
+//
+// Publishes the name (and ~/imessage-bridge/state/profile-photo.jpg if it
+// exists) once, then sends the share to that person from every +alias, so
+// every thread they have with the crew gets the "Share your name and photo?"
+// banner. The plain address is left alone.
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+
+	"maunium.net/go/mautrix/bridgev2/commands"
+)
+
+var cmdShareProfile = &commands.FullHandler{
+	Name: "share-profile",
+	Func: fnShareProfile,
+	Help: commands.HelpMeta{
+		Section:     commands.HelpSectionChats,
+		Description: "Publish the account's shared name/photo and share it with someone from every +alias. Usage: `$cmdprefix share-profile <tel:+1...|mailto:...> [display name]`",
+	},
+	RequiresLogin: true,
+}
+
+// publishProfile publishes the account's shared name + photo
+// (~/imessage-bridge/state/profile-photo.jpg if present).
+func publishProfile(client *IMClient, name string) (bool, error) {
+	var photo *[]byte
+	if home, err := os.UserHomeDir(); err == nil {
+		if data, err := os.ReadFile(filepath.Join(home, "imessage-bridge", "state", "profile-photo.jpg")); err == nil && len(data) > 0 {
+			photo = &data
+		}
+	}
+	first := strings.Fields(name)[0]
+	return photo != nil, client.client.PublishProfile(name, first, "", photo)
+}
+
+func commandClient(ce *commands.Event) *IMClient {
+	logins := ce.User.GetCachedUserLogins()
+	if len(logins) == 0 {
+		ce.Reply("You're not signed in to iMessage.")
+		return nil
+	}
+	client, ok := logins[0].Client.(*IMClient)
+	if !ok || client == nil || client.client == nil {
+		ce.Reply("The bridge client isn't ready yet. Try again in a minute.")
+		return nil
+	}
+	return client
+}
+
+// send-profile <target> [from-handle]: send the already-published name/photo
+// to one person from one of our handles, WITHOUT republishing (republishing
+// replaces the record and breaks shares already sent). Publishes first only
+// if nothing has been published since the bridge started. Iris runs this after
+// his first text to someone new.
+var cmdSendProfile = &commands.FullHandler{
+	Name: "send-profile",
+	Func: fnSendProfile,
+	Help: commands.HelpMeta{
+		Section:     commands.HelpSectionChats,
+		Description: "Send the published name/photo to one person. Usage: `$cmdprefix send-profile <tel:+1...|mailto:...> [from-handle]`",
+	},
+	RequiresLogin: true,
+}
+
+func fnSendProfile(ce *commands.Event) {
+	args := strings.Fields(ce.RawArgs)
+	if len(args) < 1 {
+		ce.Reply("Usage: `$cmdprefix send-profile <tel:+1...|mailto:...> [from-handle]`")
+		return
+	}
+	client := commandClient(ce)
+	if client == nil {
+		return
+	}
+	target := normalizeIdentifierForPortalID(args[0])
+	from := client.getHandle()
+	if len(args) > 1 {
+		if mine := client.ownHandle(args[1]); mine != "" {
+			from = mine
+		}
+	}
+	conv := client.makeConversation([]string{from, target}, nil)
+	err := client.client.SendProfileShare(conv, from)
+	if err != nil && strings.Contains(err.Error(), "No profile published") {
+		if _, perr := publishProfile(client, "Iris"); perr != nil {
+			ce.Reply("Publishing the name/photo failed: %v", perr)
+			return
+		}
+		err = client.client.SendProfileShare(conv, from)
+	}
+	if err != nil {
+		ce.Reply("Sending the name/photo to %s failed: %v", target, err)
+		return
+	}
+	ce.Reply("Sent the name/photo to %s from %s", target, from)
+}
+
+func fnShareProfile(ce *commands.Event) {
+	args := strings.Fields(ce.RawArgs)
+	if len(args) < 1 {
+		ce.Reply("Usage: `$cmdprefix share-profile <tel:+1...|mailto:...> [display name]`")
+		return
+	}
+	target := normalizeIdentifierForPortalID(args[0])
+	name := "Iris"
+	if len(args) > 1 {
+		name = strings.Join(args[1:], " ")
+	}
+	client := commandClient(ce)
+	if client == nil {
+		return
+	}
+	hasPhoto, err := publishProfile(client, name)
+	if err != nil {
+		ce.Reply("Publishing the name/photo failed: %v", err)
+		return
+	}
+
+	var sent, failed []string
+	for _, h := range client.getAllHandles() {
+		if !strings.Contains(h, "+") {
+			continue // the plain address stays untouched (on purpose)
+		}
+		conv := client.makeConversation([]string{h, target}, nil)
+		if err := client.client.SendProfileShare(conv, h); err != nil {
+			failed = append(failed, h+": "+err.Error())
+			continue
+		}
+		sent = append(sent, h)
+	}
+	ce.Reply("Published %q (photo: %v). Shared with %s from: %s%s", name, hasPhoto, target,
+		strings.Join(sent, ", "), map[bool]string{true: "\nFailed: " + strings.Join(failed, "; "), false: ""}[len(failed) > 0])
+}
diff --git a/pkg/connector/via_alias.go b/pkg/connector/via_alias.go
new file mode 100755
index 0000000..d12adbf
--- /dev/null
+++ b/pkg/connector/via_alias.go
@@ -0,0 +1,105 @@
+package connector
+
+// Per-bot threads.
+//
+// The Apple account has one alias address per bot (+atlas, +iris, ...).
+// A DM room is still keyed by the other person only, so all of the owner's
+// threads with the bot account share one Matrix room. What changes is which
+// of OUR handles a message goes out from:
+//
+//   - Incoming: the handle the owner addressed is found in the conversation
+//     participants. It becomes the room's current "via" and is stamped on the
+//     Matrix event as "com.atlas.via", so the right bot answers.
+//   - Outgoing: a bot puts "com.atlas.send_from" in the message content. If
+//     it's one of our registered handles, it becomes the room's via before
+//     anything is sent.
+//
+// Every send, typing indicator, read and delivery receipt for the room then
+// uses the via handle instead of the global selected handle, so on the owner's
+// iPhone each bot is its own conversation. Rooms with no via fall back to
+// the selected handle (old behaviour). Kept in memory only: after a restart
+// the next incoming message or bot send sets it again.
+
+import (
+	"sync"
+
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/bridgev2/networkid"
+)
+
+const (
+	viaExtraKey = "com.atlas.via"
+	sendFromKey = "com.atlas.send_from"
+)
+
+var portalVia sync.Map // networkid.PortalID -> handle string
+
+// ownHandle returns the registered handle matching h (as registered), or "".
+func (c *IMClient) ownHandle(h string) string {
+	n := normalizeIdentifierForPortalID(h)
+	if n == "" {
+		return ""
+	}
+	for _, mine := range c.getAllHandles() {
+		if normalizeIdentifierForPortalID(mine) == n {
+			return mine
+		}
+	}
+	return ""
+}
+
+// viaFromParticipants finds which of our handles a conversation addresses.
+func (c *IMClient) viaFromParticipants(participants []string) string {
+	for _, p := range participants {
+		if mine := c.ownHandle(p); mine != "" {
+			return mine
+		}
+	}
+	return ""
+}
+
+func setPortalVia(portalID networkid.PortalID, handle string) {
+	if handle != "" {
+		portalVia.Store(portalID, handle)
+	}
+}
+
+// handleForPortal is the send-from handle for a room: its via if that is
+// still one of our handles, else the globally selected handle.
+func (c *IMClient) handleForPortal(portalID networkid.PortalID) string {
+	if v, ok := portalVia.Load(portalID); ok {
+		if mine := c.ownHandle(v.(string)); mine != "" {
+			return mine
+		}
+	}
+	return c.getHandle()
+}
+
+// applySendFrom reads a bot's "com.atlas.send_from" from an outgoing Matrix
+// message and makes it the room's via.
+func (c *IMClient) applySendFrom(msg *bridgev2.MatrixMessage) {
+	if msg == nil || msg.Event == nil || msg.Portal == nil {
+		return
+	}
+	raw, _ := msg.Event.Content.Raw[sendFromKey].(string)
+	if mine := c.ownHandle(raw); mine != "" {
+		setPortalVia(msg.Portal.ID, mine)
+	}
+}
+
+// tagVia stamps the addressed handle on every part of an incoming message.
+func tagVia(cm *bridgev2.ConvertedMessage, via string) *bridgev2.ConvertedMessage {
+	if cm == nil || via == "" {
+		return cm
+	}
+	for _, part := range cm.Parts {
+		if part == nil {
+			continue
+		}
+		if part.Extra == nil {
+			part.Extra = map[string]any{}
+		}
+		part.Extra[viaExtraKey] = via
+	}
+	return cm
+}
diff --git a/pkg/rustpushgo/src/facetime_native.rs b/pkg/rustpushgo/src/facetime_native.rs
new file mode 100755
index 0000000..6defad1
--- /dev/null
+++ b/pkg/rustpushgo/src/facetime_native.rs
@@ -0,0 +1,560 @@
+//! Crew patch 2026-10-31: FaceTime audio, natively from this bridge.
+//!
+//! rustpush carries the call itself (Apple's relay, keys, SRTP) but leaves the
+//! voice codec to its caller. This is that caller: AAC-ELD through FDK in both
+//! directions, and a local socket that hands plain PCM to whoever's on the call.
+//!
+//!   127.0.0.1:8011, first line "media <guid>", then raw s16le 24 kHz mono both
+//!   ways. Bytes in get played into the call on a 20 ms clock (they queue, so
+//!   whole sentences can be written at once); bytes out are what the call hears.
+//!   Closing the socket hangs up. "flush <guid>" on the control port empties the
+//!   queue, for when someone talks over the bot.
+//!
+//! Every frame the phone sends in the first minute is also saved to
+//! data/facetime-dump-<guid>.bin as [type u8][len u16 le][bytes], so a codec
+//! mismatch can be worked out afterwards from the real thing.
+
+use fdk_aac_sys as fdk;
+use log::{info, warn};
+use rustpush::avconference::{AudioParser, AudioSender, AVSession, ChannelFrame, ChannelMessage, ChannelType};
+use rustpush::facetime::FTClient;
+use std::collections::{HashMap, VecDeque};
+use std::io::Write;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+pub(crate) const SAMPLE_RATE: u32 = 24_000;
+const FRAME_SAMPLES: usize = 480; // 20 ms at 24 kHz, what payload 104 runs at
+const BITRATE: u32 = 32_000;
+const MEDIA_PORT: u16 = 8011;
+const AOT_ELD: u32 = 39;
+const DUMP_LIMIT: usize = 4 * 1024 * 1024;
+
+// ------------------------------------------------------------------ codec ----
+
+struct Encoder(fdk::HANDLE_AACENCODER);
+unsafe impl Send for Encoder {}
+
+impl Encoder {
+    fn open(sample_rate: u32, sbr: bool, granule: u32) -> Result<(Self, Vec<u8>), String> {
+        unsafe {
+            let mut handle: fdk::HANDLE_AACENCODER = std::ptr::null_mut();
+            let check = |what: &str, code: fdk::AACENC_ERROR| {
+                if code == fdk::AACENC_ERROR_AACENC_OK { Ok(()) } else { Err(format!("{what}: {code:#x}")) }
+            };
+            check("open", fdk::aacEncOpen(&mut handle, 0, 1))?;
+            let set = |param: fdk::AACENC_PARAM, value: u32| fdk::aacEncoder_SetParam(handle, param, value);
+            check("aot", set(fdk::AACENC_PARAM_AACENC_AOT, AOT_ELD))?;
+            check("sbr", set(fdk::AACENC_PARAM_AACENC_SBR_MODE, sbr as u32))?;
+            check("rate", set(fdk::AACENC_PARAM_AACENC_SAMPLERATE, sample_rate))?;
+            check("channels", set(fdk::AACENC_PARAM_AACENC_CHANNELMODE, 1))?;
+            check("order", set(fdk::AACENC_PARAM_AACENC_CHANNELORDER, 1))?;
+            check("granule", set(fdk::AACENC_PARAM_AACENC_GRANULE_LENGTH, granule))?;
+            check("bitrate", set(fdk::AACENC_PARAM_AACENC_BITRATE, BITRATE))?;
+            check("transport", set(fdk::AACENC_PARAM_AACENC_TRANSMUX, 0))?; // raw frames
+            check("afterburner", set(fdk::AACENC_PARAM_AACENC_AFTERBURNER, 1))?;
+            check("init", fdk::aacEncEncode(handle, std::ptr::null(), std::ptr::null(), std::ptr::null(), std::ptr::null_mut()))?;
+            let mut info: fdk::AACENC_InfoStruct = std::mem::zeroed();
+            check("info", fdk::aacEncInfo(handle, &mut info))?;
+            let config = info.confBuf[..info.confSize as usize].to_vec();
+            Ok((Encoder(handle), config))
+        }
+    }
+
+    fn encode(&mut self, pcm: &[i16]) -> Option<Vec<u8>> {
+        unsafe {
+            let mut in_ptr = pcm.as_ptr() as *mut std::ffi::c_void;
+            let mut in_id = fdk::AACENC_BufferIdentifier_IN_AUDIO_DATA as i32;
+            let mut in_size = (pcm.len() * 2) as i32;
+            let mut in_elem = 2i32;
+            let in_buf = fdk::AACENC_BufDesc {
+                numBufs: 1,
+                bufs: &mut in_ptr,
+                bufferIdentifiers: &mut in_id,
+                bufSizes: &mut in_size,
+                bufElSizes: &mut in_elem,
+            };
+            let mut out = vec![0u8; 768];
+            let mut out_ptr = out.as_mut_ptr() as *mut std::ffi::c_void;
+            let mut out_id = fdk::AACENC_BufferIdentifier_OUT_BITSTREAM_DATA as i32;
+            let mut out_size = out.len() as i32;
+            let mut out_elem = 1i32;
+            let out_buf = fdk::AACENC_BufDesc {
+                numBufs: 1,
+                bufs: &mut out_ptr,
+                bufferIdentifiers: &mut out_id,
+                bufSizes: &mut out_size,
+                bufElSizes: &mut out_elem,
+            };
+            let in_args = fdk::AACENC_InArgs { numInSamples: pcm.len() as i32, numAncBytes: 0 };
+            let mut out_args: fdk::AACENC_OutArgs = std::mem::zeroed();
+            let code = fdk::aacEncEncode(self.0, &in_buf, &out_buf, &in_args, &mut out_args);
+            if code != fdk::AACENC_ERROR_AACENC_OK {
+                return None;
+            }
+            out.truncate(out_args.numOutBytes as usize);
+            Some(out)
+        }
+    }
+}
+
+impl Drop for Encoder {
+    fn drop(&mut self) {
+        unsafe { fdk::aacEncClose(&mut self.0); }
+    }
+}
+
+struct Decoder {
+    handle: fdk::HANDLE_AACDECODER,
+    name: &'static str,
+    errors: u64,
+    frames: u64,
+}
+unsafe impl Send for Decoder {}
+
+impl Decoder {
+    fn open(config: &[u8], name: &'static str) -> Option<Self> {
+        unsafe {
+            let handle = fdk::aacDecoder_Open(fdk::TRANSPORT_TYPE_TT_MP4_RAW, 1);
+            if handle.is_null() {
+                return None;
+            }
+            let mut ptr = config.as_ptr() as *mut u8;
+            let len = config.len() as u32;
+            if fdk::aacDecoder_ConfigRaw(handle, &mut ptr, &len) != fdk::AAC_DECODER_ERROR_AAC_DEC_OK {
+                fdk::aacDecoder_Close(handle);
+                return None;
+            }
+            Some(Decoder { handle, name, errors: 0, frames: 0 })
+        }
+    }
+
+    /// One frame in, PCM out at the stream's own rate. None on a decode error.
+    fn decode(&mut self, frame: &[u8]) -> Option<(Vec<i16>, u32)> {
+        unsafe {
+            let mut ptr = frame.as_ptr() as *mut u8;
+            let size = frame.len() as u32;
+            let mut valid = size;
+            fdk::aacDecoder_Fill(self.handle, &mut ptr, &size, &mut valid);
+            let mut out = vec![0i16; 8192];
+            let code = fdk::aacDecoder_DecodeFrame(self.handle, out.as_mut_ptr(), out.len() as i32, 0);
+            self.frames += 1;
+            if code != fdk::AAC_DECODER_ERROR_AAC_DEC_OK {
+                self.errors += 1;
+                return None;
+            }
+            let info = fdk::aacDecoder_GetStreamInfo(self.handle);
+            if info.is_null() {
+                return None;
+            }
+            let info = &*info;
+            let samples = (info.frameSize * info.numChannels) as usize;
+            out.truncate(samples.min(8192));
+            let channels = info.numChannels.max(1) as usize;
+            if channels > 1 {
+                out = out.chunks(channels).map(|c| c[0]).collect();
+            }
+            Some((out, info.sampleRate as u32))
+        }
+    }
+}
+
+impl Drop for Decoder {
+    fn drop(&mut self) {
+        unsafe { fdk::aacDecoder_Close(self.handle); }
+    }
+}
+
+/// The configs Apple might be running AAC-ELD at. The first frames pick one:
+/// whichever decodes them without errors and isn't silence.
+fn decoder_candidates() -> Vec<Decoder> {
+    let configs: [(&'static str, u32, bool, u32); 5] = [
+        ("eld-24k-480", 24_000, false, 480),
+        ("eld-24k-512", 24_000, false, 512),
+        ("eld-48k-480", 48_000, false, 480),
+        ("eld-48k-sbr", 48_000, true, 480),
+        ("eld-32k-480", 32_000, false, 480),
+    ];
+    configs
+        .iter()
+        .filter_map(|(name, rate, sbr, granule)| {
+            let (_, config) = Encoder::open(*rate, *sbr, *granule).map_err(|e| warn!("FaceTime audio: no config for {name}: {e}")).ok()?;
+            info!("FaceTime audio: candidate {name} config {}", hex(&config));
+            Decoder::open(&config, name)
+        })
+        .collect()
+}
+
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+fn resample(pcm: &[i16], from: u32, to: u32) -> Vec<i16> {
+    if from == to || from == 0 || pcm.is_empty() {
+        return pcm.to_vec();
+    }
+    let count = pcm.len() * to as usize / from as usize;
+    (0..count)
+        .map(|i| {
+            let at = i as f64 * from as f64 / to as f64;
+            let low = at as usize;
+            let high = (low + 1).min(pcm.len() - 1);
+            let frac = at - low as f64;
+            (pcm[low] as f64 * (1.0 - frac) + pcm[high] as f64 * frac) as i16
+        })
+        .collect()
+}
+
+/// Encode a second of a tone, decode it through the same path a call uses, and
+/// report how much survived.
+pub(crate) fn codec_roundtrip() -> serde_json::Value {
+    let (mut encoder, config) = match Encoder::open(SAMPLE_RATE, false, FRAME_SAMPLES as u32) {
+        Ok(opened) => opened,
+        Err(e) => return serde_json::json!({ "ok": false, "error": e }),
+    };
+    let Some(mut decoder) = Decoder::open(&config, "roundtrip") else {
+        return serde_json::json!({ "ok": false, "error": "no decoder" });
+    };
+    let tone: Vec<i16> = (0..SAMPLE_RATE as usize * 2)
+        .map(|i| ((i as f64 * 440.0 * std::f64::consts::TAU / SAMPLE_RATE as f64).sin() * 8000.0) as i16)
+        .collect();
+    let (mut packets, mut bytes, mut decoded, mut bad) = (0u32, 0usize, Vec::new(), 0u32);
+    for chunk in tone.chunks_exact(FRAME_SAMPLES) {
+        let Some(frame) = encoder.encode(chunk) else { bad += 1; continue };
+        if frame.is_empty() {
+            continue;
+        }
+        let mut packet = vec![frame.len().min(255) as u8];
+        packet.extend_from_slice(&frame);
+        packets += 1;
+        bytes += packet.len();
+        for parsed in AudioParser(&packet) {
+            match decoder.decode(parsed) {
+                Some((pcm, _)) => decoded.extend(pcm),
+                None => bad += 1,
+            }
+        }
+    }
+    let tail = &decoded[decoded.len().saturating_sub(SAMPLE_RATE as usize)..];
+    let rms = (tail.iter().map(|s| (*s as f64).powi(2)).sum::<f64>() / tail.len().max(1) as f64).sqrt();
+    serde_json::json!({
+        "ok": bad == 0 && rms > 2000.0,
+        "config": hex(&config),
+        "packets": packets,
+        "bytes_per_packet": bytes / packets.max(1) as usize,
+        "decoded_samples": decoded.len(),
+        "bad": bad,
+        "rms": rms as u32,
+        "input_rms": (8000.0 / std::f64::consts::SQRT_2) as u32,
+    })
+}
+
+// ------------------------------------------------------------- one call ----
+
+pub(crate) struct CallAudio {
+    guid: String,
+    outgoing: Mutex<VecDeque<i16>>,
+    listener: Mutex<Option<std::sync::mpsc::Sender<Vec<u8>>>>,
+    running: AtomicBool,
+    sending: AtomicBool,
+    frames_in: AtomicU64,
+    frames_out: AtomicU64,
+    dump: Mutex<Option<(std::fs::File, usize)>>,
+}
+
+static CALLS: Mutex<Option<HashMap<String, Arc<CallAudio>>>> = Mutex::new(None);
+
+fn call_audio(guid: &str) -> Option<Arc<CallAudio>> {
+    CALLS.lock().unwrap().as_ref()?.get(guid).cloned()
+}
+
+/// Wire a live native session up to the audio: frames in from now on, frames
+/// out as soon as someone else is on the line.
+pub(crate) async fn start_audio(connection: Arc<AVSession>, guid: String) {
+    let dump = std::fs::File::create(format!("facetime-dump-{guid}.bin")).ok().map(|f| (f, 0));
+    let call = Arc::new(CallAudio {
+        guid: guid.clone(),
+        outgoing: Mutex::new(VecDeque::new()),
+        listener: Mutex::new(None),
+        running: AtomicBool::new(true),
+        sending: AtomicBool::new(false),
+        frames_in: AtomicU64::new(0),
+        frames_out: AtomicU64::new(0),
+        dump: Mutex::new(dump),
+    });
+    CALLS.lock().unwrap().get_or_insert_with(HashMap::new).insert(guid.clone(), call.clone());
+
+    let incoming = call.clone();
+    let decoder: Mutex<(Vec<Decoder>, Option<Decoder>)> = Mutex::new((decoder_candidates(), None));
+    connection.frame_handler.configure_handler(Box::new(move |message| {
+        incoming.on_frame(message, &decoder);
+    }));
+
+    tokio::spawn(async move {
+        // Nobody to send to until the other side is in the relay session.
+        let started = Instant::now();
+        let peer = loop {
+            if !call.running.load(Ordering::Relaxed) || started.elapsed() > Duration::from_secs(120) {
+                return;
+            }
+            if connection.has_peer().await {
+                break true;
+            }
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        };
+        if !peer {
+            return;
+        }
+        info!("FaceTime audio: someone's on {}, sending from now on", call.guid);
+        let sender = connection.create_audio_sender(2, None, &[]).await;
+        let sending = call.clone();
+        std::thread::spawn(move || sending.send_loop(sender));
+    });
+}
+
+impl CallAudio {
+    fn on_frame(&self, message: ChannelMessage, decoder: &Mutex<(Vec<Decoder>, Option<Decoder>)>) {
+        let ChannelFrame::Sample(data) = &message.frame else { return };
+        let count = self.frames_in.fetch_add(1, Ordering::Relaxed);
+        if count < 8 || count % 500 == 0 {
+            info!("FaceTime audio: in {:?} stream {} frame {count}, {} bytes: {}",
+                message.r#type, message.stream.stream_index, data.len(), hex(&data[..data.len().min(32)]));
+        }
+        self.write_dump(&message.r#type, data);
+        if !matches!(message.r#type, ChannelType::Aac | ChannelType::Aac48) {
+            return; // EVS from the phone: the dump has it, nothing here decodes it
+        }
+        let mut decoder = decoder.lock().unwrap();
+        for frame in AudioParser(data) {
+            let decoded = match &mut decoder.1 {
+                Some(chosen) => chosen.decode(frame),
+                None => {
+                    // Try every candidate on the same frame until one holds.
+                    let (candidates, _) = &mut *decoder;
+                    let mut result = None;
+                    let mut pick = None;
+                    for (i, candidate) in candidates.iter_mut().enumerate() {
+                        if let Some(output) = candidate.decode(frame) {
+                            let loud = output.0.iter().any(|s| s.unsigned_abs() > 8);
+                            if candidate.frames >= 25 && candidate.errors * 5 <= candidate.frames && loud {
+                                info!("FaceTime audio: decoding as {} at {} Hz, {} of {} frames bad",
+                                    candidate.name, output.1, candidate.errors, candidate.frames);
+                                pick = Some(i);
+                                result = Some(output);
+                                break;
+                            }
+                        }
+                    }
+                    if let Some(i) = pick {
+                        let chosen = decoder.0.swap_remove(i);
+                        decoder.1 = Some(chosen);
+                        decoder.0.clear();
+                    }
+                    result
+                }
+            };
+            let Some((pcm, rate)) = decoded else { continue };
+            let pcm = resample(&pcm, rate, SAMPLE_RATE);
+            let bytes: Vec<u8> = pcm.iter().flat_map(|s| s.to_le_bytes()).collect();
+            if let Some(listener) = self.listener.lock().unwrap().as_ref() {
+                let _ = listener.send(bytes);
+            }
+        }
+    }
+
+    fn write_dump(&self, kind: &ChannelType, data: &[u8]) {
+        let mut dump = self.dump.lock().unwrap();
+        let Some((file, written)) = dump.as_mut() else { return };
+        if *written > DUMP_LIMIT {
+            return;
+        }
+        let tag = match kind {
+            ChannelType::Evs => 1u8,
+            ChannelType::Aac => 2,
+            ChannelType::Aac48 => 3,
+            _ => return,
+        };
+        let _ = file.write_all(&[tag]);
+        let _ = file.write_all(&(data.len() as u16).to_le_bytes());
+        let _ = file.write_all(data);
+        *written += 3 + data.len();
+    }
+
+    /// 20 ms clock: whatever's queued goes out, silence otherwise, so the far
+    /// end always hears a live stream.
+    fn send_loop(self: Arc<Self>, mut sender: AudioSender) {
+        let (mut encoder, config) = match Encoder::open(SAMPLE_RATE, false, FRAME_SAMPLES as u32) {
+            Ok(opened) => opened,
+            Err(e) => {
+                warn!("FaceTime audio: no encoder: {e}");
+                return;
+            }
+        };
+        info!("FaceTime audio: sending AAC-ELD, config {}", hex(&config));
+        self.sending.store(true, Ordering::Relaxed);
+        let mut next = Instant::now();
+        let mut timestamp: u32 = rand::random::<u32>() & 0x00ff_ffff;
+        let mut pcm = [0i16; FRAME_SAMPLES];
+        while self.running.load(Ordering::Relaxed) {
+            {
+                let mut queue = self.outgoing.lock().unwrap();
+                for slot in pcm.iter_mut() {
+                    *slot = queue.pop_front().unwrap_or(0);
+                }
+            }
+            if let Some(frame) = encoder.encode(&pcm) {
+                if !frame.is_empty() {
+                    // [size][frame], the same shape AudioParser reads coming in
+                    let mut packet = Vec::with_capacity(frame.len() + 1);
+                    packet.push(frame.len().min(255) as u8);
+                    packet.extend_from_slice(&frame);
+                    match sender.send_audio_frame(&packet, timestamp) {
+                        Ok(()) => {
+                            let sent = self.frames_out.fetch_add(1, Ordering::Relaxed);
+                            if sent < 3 || sent % 500 == 0 {
+                                info!("FaceTime audio: out frame {sent}, {} bytes", packet.len());
+                            }
+                        }
+                        Err(e) => warn!("FaceTime audio: send failed: {e:?}"),
+                    }
+                }
+            }
+            timestamp = timestamp.wrapping_add(FRAME_SAMPLES as u32);
+            next += Duration::from_millis(20);
+            let now = Instant::now();
+            if next > now {
+                std::thread::sleep(next - now);
+            } else if now - next > Duration::from_millis(200) {
+                next = now; // fell behind (a stall): don't burst to catch up
+            }
+        }
+        info!("FaceTime audio: {} stopped after {} frames in, {} out", self.guid,
+            self.frames_in.load(Ordering::Relaxed), self.frames_out.load(Ordering::Relaxed));
+    }
+
+    pub(crate) fn stats(&self) -> serde_json::Value {
+        serde_json::json!({
+            "frames_in": self.frames_in.load(Ordering::Relaxed),
+            "frames_out": self.frames_out.load(Ordering::Relaxed),
+            "sending": self.sending.load(Ordering::Relaxed),
+            "queued_ms": self.outgoing.lock().unwrap().len() as u64 * 1000 / SAMPLE_RATE as u64,
+        })
+    }
+
+    fn stop(&self) {
+        self.running.store(false, Ordering::Relaxed);
+        *self.listener.lock().unwrap() = None;
+    }
+}
+
+pub(crate) fn audio_stats(guid: &str) -> Option<serde_json::Value> {
+    Some(call_audio(guid)?.stats())
+}
+
+pub(crate) fn flush_audio(guid: &str) -> bool {
+    match call_audio(guid) {
+        Some(call) => {
+            call.outgoing.lock().unwrap().clear();
+            true
+        }
+        None => false,
+    }
+}
+
+pub(crate) fn stop_audio(guid: &str) {
+    if let Some(calls) = CALLS.lock().unwrap().as_mut() {
+        if let Some(call) = calls.remove(guid) {
+            call.stop();
+        }
+    }
+}
+
+// ----------------------------------------------------------- media socket ----
+
+static MEDIA_STARTED: std::sync::Once = std::sync::Once::new();
+
+pub(crate) fn start_media_port(facetime: fn() -> Option<Arc<FTClient>>) {
+    MEDIA_STARTED.call_once(|| {
+        tokio::spawn(async move {
+            let listener = match tokio::net::TcpListener::bind(("127.0.0.1", MEDIA_PORT)).await {
+                Ok(listener) => listener,
+                Err(e) => {
+                    warn!("FaceTime media port {MEDIA_PORT} didn't open: {e}");
+                    return;
+                }
+            };
+            info!("FaceTime media port open on {MEDIA_PORT}");
+            loop {
+                let Ok((stream, _)) = listener.accept().await else { continue };
+                tokio::spawn(media_connection(stream, facetime));
+            }
+        });
+    });
+}
+
+async fn media_connection(stream: tokio::net::TcpStream, facetime: fn() -> Option<Arc<FTClient>>) {
+    use tokio::io::{AsyncBufReadExt, AsyncReadExt, AsyncWriteExt};
+    let _ = stream.set_nodelay(true);
+    let (read, mut write) = stream.into_split();
+    let mut reader = tokio::io::BufReader::new(read);
+    let mut line = String::new();
+    if !matches!(tokio::time::timeout(Duration::from_secs(5), reader.read_line(&mut line)).await, Ok(Ok(n)) if n > 0) {
+        return;
+    }
+    let Some(guid) = line.trim().strip_prefix("media ").map(str::to_string) else { return };
+    let Some(call) = call_audio(&guid) else {
+        let _ = write.write_all(b"no such call\n").await;
+        return;
+    };
+    info!("FaceTime media: socket attached to {guid}");
+    let _ = write.write_all(b"ok\n").await;
+
+    // call -> socket
+    let (to_socket, from_call) = std::sync::mpsc::channel::<Vec<u8>>();
+    *call.listener.lock().unwrap() = Some(to_socket);
+    let (bytes_out, mut bytes_in) = tokio::sync::mpsc::unbounded_channel::<Vec<u8>>();
+    std::thread::spawn(move || {
+        while let Ok(bytes) = from_call.recv() {
+            if bytes_out.send(bytes).is_err() {
+                break;
+            }
+        }
+    });
+    let writer = tokio::spawn(async move {
+        while let Some(bytes) = bytes_in.recv().await {
+            if write.write_all(&bytes).await.is_err() {
+                break;
+            }
+        }
+    });
+
+    // socket -> call
+    let mut buffer = vec![0u8; 8192];
+    let mut leftover: Option<u8> = None;
+    loop {
+        match reader.read(&mut buffer).await {
+            Ok(0) | Err(_) => break,
+            Ok(n) => {
+                let mut bytes = &buffer[..n];
+                let mut queue = call.outgoing.lock().unwrap();
+                if let (Some(low), Some(high)) = (leftover, bytes.first()) {
+                    queue.push_back(i16::from_le_bytes([low, *high]));
+                    leftover = None;
+                    bytes = &bytes[1..];
+                }
+                let chunks = bytes.chunks_exact(2);
+                leftover = chunks.remainder().first().copied();
+                for chunk in chunks {
+                    queue.push_back(i16::from_le_bytes([chunk[0], chunk[1]]));
+                }
+            }
+        }
+    }
+    info!("FaceTime media: socket closed, hanging up {guid}");
+    writer.abort();
+    *call.listener.lock().unwrap() = None;
+    if let Some(facetime) = facetime() {
+        crate::facetime_notify::hang_up(&facetime, &guid).await;
+    }
+}
