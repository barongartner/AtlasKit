+// Capture mode (Atlas, 2026-11-17). To send sticker tapbacks and Apple's
+// special link cards (YouTube, Music, Maps, App Store) the bridge has to copy
+// exactly what an iPhone sends, and nothing documents that format. While
+// ~/imessage-bridge/state/capture-on exists, every incoming sticker tapback and
+// every link card with a specialization (or one that fails to parse) is saved
+// as an XML plist in ~/imessage-bridge/captures/. Data blobs over 4 KB (the
+// pictures) are replaced by their size, so it's text only. Off by default;
+// delete the flag file and the folder when done.
+fn atlas_capture(kind: &str, value: &Value) {
+    let home = std::env::var("HOME").unwrap_or_default();
+    if home.is_empty() || !std::path::Path::new(&format!("{home}/imessage-bridge/state/capture-on")).exists() {
+        return;
+    }
+    fn shrink(v: &Value) -> Value {
+        match v {
+            Value::Data(d) if d.len() > 4096 => Value::String(format!("<{} bytes of data, not kept>", d.len())),
+            Value::Data(d) => {
+                // Small blobs are often nested binary plists or archives: keep them readable.
+                match plist::Value::from_reader(Cursor::new(d)) {
+                    Ok(inner) if !matches!(inner, Value::Data(_)) => {
+                        let mut wrap = Dictionary::new();
+                        wrap.insert("__nested_plist__".to_string(), shrink(&inner));
+                        Value::Dictionary(wrap)
+                    }
+                    _ => v.clone(),
+                }
+            }
+            Value::Array(a) => Value::Array(a.iter().map(shrink).collect()),
+            Value::Dictionary(d) => Value::Dictionary(d.iter().map(|(k, v)| (k.clone(), shrink(v))).collect()),
+            other => other.clone(),
+        }
+    }
+    let dir = format!("{home}/imessage-bridge/captures");
+    if std::fs::create_dir_all(&dir).is_err() {
+        return;
+    }
+    let ms = SystemTime::now().duration_since(UNIX_EPOCH).map(|d| d.as_millis()).unwrap_or(0);
+    let path = format!("{dir}/{kind}-{ms}.plist");
+    match shrink(value).to_file_xml(&path) {
+        Ok(()) => info!("Captured {} to {}", kind, path),
+        Err(e) => warn!("Capture of {} failed: {}", kind, e),
+    }
+}
